{
  "expo": {
    "name": "Nama",
    "slug": "nama",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/app/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/images/app/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/app/android-icon-background.png",
        "monochromeImage": "./src/assets/images/app/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./src/assets/images/app/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/app/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#001612"
        }
      ],
      "expo-asset",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Nama uses the microphone so you can talk to the Nama Assistant."
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Nama uses the camera so the assistant can see what you show it.",
          "microphonePermission": "Nama uses the microphone so you can talk to the Nama Assistant.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Nama uses the camera for video calls and so the assistant can see what you show it.",
          "microphonePermission": "Nama uses the microphone for video calls and to talk to the Nama Assistant."
        }
      ]
    ]
  }
}
