# Copy to .env.local (git ignores it) and fill in. EXPO_PUBLIC_ values are compiled into the
# app bundle, so never put a secret here that must stay on a server.

# Assistant backend (text chat over REST, realtime voice over WebSocket).
# Optional: defaults to the hosted assistant used by the Parklane app.
EXPO_PUBLIC_ASSISTANT_URL=

# Smart Home: the unit's eWeLink CUBE hub on the local network, and its web console password.
# Without the password the Smart Home screen shows sample devices.
EXPO_PUBLIC_CUBE_URL=http://192.168.1.119
EXPO_PUBLIC_CUBE_PASSWORD=

# Video calls (src/constants/meetConfig.ts). The meet server; defaults to https://meet.ems-iot.com.
EXPO_PUBLIC_MEET_URL=
# Web build only: where the browser sends REST calls. Empty uses the same-origin /meet proxy
# (dev server and Vercel). Set it to the server's URL once the server sends CORS headers.
EXPO_PUBLIC_MEET_API_BASE=
